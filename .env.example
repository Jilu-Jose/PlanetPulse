# Copy this to .env and fill in your values. Never commit .env.

# ── LLM / AI ──────────────────────────────────────────────────────────────────
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME="gpt OSS 120b"

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite: absolute or relative path works; mount a persistent disk in production
DATABASE_URL=sqlite:///./planetpulse.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
